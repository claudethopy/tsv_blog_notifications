<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- E-Mail-Body (QWeb, wird pro Empfänger gerendert) -->
    <template id="blog_notification_email_body">
        <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; color: #333;">
            <div style="background: #003366; padding: 20px 30px;">
                <h1 style="color: white; margin: 0; font-size: 20px;">TSV Schwerin</h1>
            </div>
            <div style="padding: 30px;">
                <p style="color: #666; margin-top: 0;">Neuer Beitrag im Blog
                    <strong><t t-out="post.blog_id.name"/></strong>
                </p>
                <h2 style="margin-top: 0;"><t t-out="post.name"/></h2>
                <t t-if="post.subtitle">
                    <p style="color: #555; font-style: italic;"><t t-out="post.subtitle"/></p>
                </t>
                <p style="margin-top: 24px;">
                    <a t-att-href="base_url + post.website_url"
                       style="background: #003366; color: white; padding: 12px 24px;
                              text-decoration: none; border-radius: 4px; display: inline-block;">
                        Beitrag lesen
                    </a>
                </p>
            </div>
            <div style="border-top: 1px solid #eee; padding: 20px 30px; font-size: 12px; color: #999;">
                <p style="margin: 0;">
                    Sie erhalten diese E-Mail als Mitglied des TSV Schwerin.<br/>
                    <a t-att-href="unsubscribe_blog_url" style="color: #999;">
                        Nur von diesem Blog abmelden
                    </a>
                    &#160;|&#160;
                    <a t-att-href="unsubscribe_all_url" style="color: #999;">
                        Von allen Blog-Benachrichtigungen abmelden
                    </a>
                </p>
            </div>
        </div>
    </template>

    <!-- Abmelde-Bestätigung -->
    <template id="blog_unsubscribe_done">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row justify-content-center">
                    <div class="col-md-6 text-center">
                        <h2>Abmeldung bestätigt</h2>
                        <t t-if="mode == 'all'">
                            <p>Sie erhalten ab sofort keine Blog-Benachrichtigungen mehr.</p>
                        </t>
                        <t t-if="mode == 'blog'">
                            <p>
                                Sie wurden vom Blog <strong><t t-out="blog_name"/></strong>
                                abgemeldet. Benachrichtigungen anderer Blogs erhalten Sie
                                weiterhin.
                            </p>
                        </t>
                        <a href="/" class="btn btn-primary mt-3">Zur Startseite</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Ungültiger Token -->
    <template id="blog_unsubscribe_invalid">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <div class="row justify-content-center">
                    <div class="col-md-6 text-center">
                        <h2>Link ungültig</h2>
                        <p>Dieser Abmelde-Link ist nicht gültig.</p>
                        <a href="/" class="btn btn-primary mt-3">Zur Startseite</a>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
