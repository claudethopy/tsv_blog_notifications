<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_blog_notifications" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.blog.notifications</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block"
                     data-string="Blog-Benachrichtigungen"
                     string="Blog-Benachrichtigungen"
                     data-key="tsv_blog_notifications">
                    <h2>Blog-Benachrichtigungen</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="blog_notifications_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="blog_notifications_enabled"/>
                                <div class="text-muted">
                                    Aktiviert den automatischen E-Mail-Versand bei neuen Blogbeiträgen.
                                    Deaktiviert werden beim Veröffentlichen keine Benachrichtigungen verschickt.
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="blog_notifications_batch_size" string="E-Mails pro Sendevorgang"/>
                                <field name="blog_notifications_batch_size"/>
                                <div class="text-muted">
                                    Anzahl E-Mails, die der Cron-Job alle 5 Minuten verschickt (Standard: 30).
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
